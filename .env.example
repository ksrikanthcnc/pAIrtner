TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Gemini (default LLM provider) ---
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_DEFAULT=gemini-3.1-flash-lite
MODEL_HEAVY=gemini-3-flash-preview,gemini-3.8-flash
HEAVY_DAILY_CAP=10

# --- Switchable LLM provider ---
# LLM_PROVIDER=gemini            # "gemini" (default) or "openai_compat"
# LLM_BASE_URL=                  # Base URL for OpenAI-compat API (e.g. https://api.groq.com/openai/v1)
# LLM_API_KEY=                   # API key for the OpenAI-compat provider
# LLM_MODEL_DEFAULT=             # Default model for OpenAI-compat (falls back to MODEL_DEFAULT)
# LLM_MODEL_HEAVY=               # Heavy models for OpenAI-compat, comma-separated (falls back to MODEL_HEAVY)

# --- General ---
COOLDOWN_MINUTES=15
DB_PATH=couples_bot.db

# --- Database encryption (FEAT-003) ---
# DB_ENCRYPTION_KEY=          # Fernet key for encrypting sensitive DB fields

# --- Access control ---
# Comma-separated Telegram user IDs. Empty = open mode (allow everyone).
ALLOWED_USER_IDS=
