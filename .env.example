TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Gemini (default LLM provider) ---
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_DEFAULT=gemini-2.0-flash-lite
MODEL_HEAVY=gemini-3-flash-preview,gemini-3.8-flash
HEAVY_DAILY_CAP=10

# --- Switchable LLM provider ---
# "gemini" (default) or "openai_compat"
LLM_PROVIDER=gemini
# LLM_BASE_URL=                  # Base URL for OpenAI-compat API (e.g. https://api.groq.com/openai/v1)
# LLM_API_KEY=                   # API key for the OpenAI-compat provider
# LLM_MODEL_DEFAULT=             # Default model for OpenAI-compat (falls back to MODEL_DEFAULT)
# LLM_MODEL_HEAVY=               # Heavy models for OpenAI-compat, comma-separated (falls back to MODEL_HEAVY)

# --- General ---
COOLDOWN_MINUTES=15
# Docker volume path; use pairtner.db when running natively
DB_PATH=/data/pairtner.db

# --- Database encryption (FEAT-003) ---
# Fernet key for encrypting sensitive couple config (e.g. BYO Gemini keys).
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DB_ENCRYPTION_KEY=

# --- Access control ---
# Comma-separated Telegram user IDs. Empty = open mode (allow everyone).
ALLOWED_USER_IDS=
# Comma-separated Telegram user IDs with admin rights
ADMIN_USER_IDS=
# Optional: disable thinking on reasoning models served by Ollama (e.g. qwen3). Leave empty for other providers.
# LLM_REASONING_EFFORT=none

# --- Dashboard (token must be 16+ chars) ---
DASHBOARD_TOKEN=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
DASHBOARD_BIND=127.0.0.1

# --- REST API ---
ADAPTER=telegram+rest
REST_HOST=0.0.0.0
REST_PORT=8080
REST_BIND=127.0.0.1
# For duo.html / duo_keep.html dev testing (auto-register without invite):
# REST_REGISTRATION=open
