# wAIldo — Solo personal journal bot
# Copy to .env.waildo and fill in your values

# Telegram bot token from @BotFather (wAIldo_bot)
TELEGRAM_BOT_TOKEN=your-waildo-token-here

# LLM provider: gemini (default) or openai_compat (Ollama)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=local
# LLM_MODEL_DEFAULT=qwen3:8b

# For Gemini:
GEMINI_API_KEY=your-gemini-key-here

# Solo mode (no partner features)
SOLO_MODE=true
